# Adresse du VPS (nom de domaine ou IP)
VPS_HOST=chemin-de-guer.fr
VPS_USER=cdgbackup
VPS_PORT=22
# Dossier du NAS où copier les sauvegardes (chemin absolu sur le NAS, par exemple /volume1/backups/chemin-de-guer)
DEST_DIR=./backups
# Fréquence de récupération, en heures (le VPS sauvegarde une fois par jour à 3 h 30)
PULL_EVERY_HOURS=6
# Nombre de sauvegardes à garder sur le NAS (0 = toutes)
KEEP_COUNT=0
