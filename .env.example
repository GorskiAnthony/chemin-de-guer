DB_NAME=chemin_de_guer
DB_USER=postgres
DB_PASSWORD=change-me

# Compte administrateur créé au premier démarrage (mot de passe : 12 caractères minimum)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please-123

# URL publique du site (sitemap, RSS). Avec un domaine et HTTPS : https://votre-domaine.fr
APP_PUBLIC_URL=http://IP_DU_VPS
# true dès que le site est servi en HTTPS (domaine + Dokploy/Let's Encrypt)
COOKIE_SECURE=false

# Fermeture pour Shabbat (Paris par défaut)
SHABBAT_ENABLED=true
SHABBAT_GEONAME_ID=2988507
SHABBAT_TIMEZONE=Europe/Paris
SHABBAT_MARGIN_MINUTES=30
# Port HTTP publié sur la machine hôte (accès direct uniquement, ignoré par Dokploy)
FRONTEND_PORT=80

# Commentaires : false pour démarrer avec les commentaires fermés (réglable ensuite dans l'administration)
COMMENTS_ENABLED=true

# Notification email des nouveaux commentaires à modérer (facultatif : sans MAIL_HOST, rien n'est envoyé)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Expéditeur (souvent identique à MAIL_USERNAME) et destinataire (par défaut ADMIN_EMAIL)
MAIL_FROM=
MAIL_TO=

# Auteur affiché dans les données structurées (SEO) et les fichiers llms.txt
AUTHOR_NAME=Anthony Gorski
AUTHOR_URL=https://www.agorski.dev

# Référencement : false (défaut) = le site porte une directive noindex partout et refuse les robots IA ;
# true = indexable (sitemap, llms.txt et robots.txt ouvert aux moteurs)
SITE_INDEXABLE=false

# Sauvegardes automatiques (service cdg-backup) : tous les jours à 3 h 30, les 30 plus récentes conservées
BACKUP_CRON=30 3 * * *
BACKUP_KEEP=30
# Chiffrement AES-256 des sauvegardes (conseillé pour la copie hors serveur) : garder cette phrase en lieu sûr !
BACKUP_PASSPHRASE=
# Copie hors serveur, au choix : S3 compatible (OVH Object Storage, Backblaze B2, Scaleway...)...
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# ... ou SFTP
BACKUP_SFTP_HOST=
BACKUP_SFTP_USER=
BACKUP_SFTP_PASSWORD=

# Dossier du serveur où déposer les sauvegardes (chemin absolu), pour qu'un NAS les récupère : voir nas/README.md.
# Vide = volume Docker (comportement par défaut).
BACKUP_DIR=
